# ----------------------------------------------------------------------
# 1. ZÁKLADNÍ NASTAVENÍ A SMĚROVÁNÍ
# ----------------------------------------------------------------------
RewriteEngine On
RewriteBase /

# Vynucení HTTPS a zároveň Přesměrování z www.radovanbista.cz na radovanbista.cz
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Odstranění koncovky .html z URL
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# ----------------------------------------------------------------------
# 2. CHYBOVÉ STRÁNKY
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# 3. BEZPEČNOST
# ----------------------------------------------------------------------
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# ----------------------------------------------------------------------
# 4. RYCHLOST A KEŠOVÁNÍ
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Obrázky kešovat (1 rok)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS a JS NENECHÁVAT v keši (zabrání rozbíjení stránek při změnách kódu)
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
</IfModule>

# Komprese GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>